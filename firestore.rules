rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    function canDeleteTrips() {
      return isAdmin()
        && (!get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.keys().hasAny(['canDeleteTrips'])
          || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.canDeleteTrips == true);
    }

    function canClearAllData() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.canClearAllData == true;
    }

    function canManageMembers() {
      return isAdmin()
        && (!get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.keys().hasAny(['canManageMembers'])
          || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.canManageMembers == true);
    }

    function canManageAccess() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.canManageAccess == true;
    }

    function isTripMember(tripId) {
      return signedIn()
        && exists(/databases/$(database)/documents/trips/$(tripId))
        && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids;
    }

    // Admin access records are created manually for the first project owner,
    // then can be managed from the Tripwise Settings screen.
    match /admins/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if canManageAccess();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if canManageMembers() || (signedIn() && request.auth.uid == userId);
      allow delete: if canManageMembers() || canManageAccess() || (signedIn() && request.auth.uid == userId);

      match /workspaces/{workspaceId} {
        allow read, write: if isAdmin() || (signedIn() && request.auth.uid == userId);
      }
    }

    match /trips/{tripId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.memberUids);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if canManageMembers()
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.memberUids == resource.data.memberUids
        );
      allow delete: if canDeleteTrips() || canClearAllData();

      match /expenses/{expenseId} {
        allow read: if isAdmin() || isTripMember(tripId);
        allow create: if isAdmin() || (
          isTripMember(tripId)
          && request.resource.data.createdByUid == request.auth.uid
        );
        allow update: if canDeleteTrips() || (
          isTripMember(tripId)
          && resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByUid == request.auth.uid
        );
        allow delete: if canDeleteTrips() || (
          isTripMember(tripId)
          && resource.data.createdByUid == request.auth.uid
        );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
